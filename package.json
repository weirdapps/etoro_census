{
  "name": "etoro-census",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3600",
    "dev:v2": "NEXT_PUBLIC_USE_V2_FEATURES=true next dev --port 3600",
    "dev-original": "npm-run-all -s kill-port dev-only",
    "dev-only": "next dev --turbopack --port 3600",
    "kill-port": "npx -y kill-port 3600",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start --port ${PORT:-3000}",
    "start-azure": "node server.js",
    "lint": "next lint",
    "export": "next build && next export",
    "azure-build": "next build",
    "create-zip": "cd build && zip -r ../build.zip .",
    "sync": "bash scripts/sync-all-data.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "^2.89.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.484.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^18.2.0",
    "recharts": "3.6.0",
    "tailwind-merge": "^3.1.0",
    "tw-animate-css": "^1.2.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "typescript": "5.8.3",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
