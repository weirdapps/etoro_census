{
  "name": "etoro-census",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3600",
    "dev:v2": "NEXT_PUBLIC_USE_V2_FEATURES=true next dev --port 3600",
    "dev-original": "npm-run-all -s kill-port dev-only",
    "dev-only": "next dev --turbopack --port 3600",
    "kill-port": "npx -y kill-port 3600",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint",
    "create-zip": "cd build && zip -r ../build.zip .",
    "sync": "bash scripts/sync-all-data.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "analysis:daily": "tsx analysis/daily-post.ts",
    "analysis:weekly": "tsx analysis/weekly-post.ts",
    "analysis:monthly": "tsx analysis/monthly-post.ts",
    "analysis:all": "tsx analysis/generate-all-posts.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "kill-port": "^2.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "@babel/core": ">=7.29.6",
    "sharp": ">=0.35.3"
  }
}
