{
  "name": "etoro-census",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3600",
    "dev:v2": "NEXT_PUBLIC_USE_V2_FEATURES=true next dev --port 3600",
    "dev-original": "npm-run-all -s kill-port dev-only",
    "dev-only": "next dev --turbopack --port 3600",
    "kill-port": "npx -y kill-port 3600",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint",
    "create-zip": "cd build && zip -r ../build.zip .",
    "sync": "bash scripts/sync-all-data.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "analysis:daily": "tsx analysis/daily-post.ts",
    "analysis:weekly": "tsx analysis/weekly-post.ts",
    "analysis:monthly": "tsx analysis/monthly-post.ts",
    "analysis:all": "tsx analysis/generate-all-posts.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.35",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^16.3.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
