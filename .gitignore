# Analysis output (generated data, can be regenerated)
analysis/output/

# Historical census data - stored in data-archive branch (permanent Git storage)
# Main branch only tracks census-data-latest.json to keep deployments fast
#
# Architecture:
# - data-archive branch: ALL historical dated files (permanent, no expiration)
# - main branch: Only census-data-latest.json (for Vercel deployment)
# - Local access: Use 'git worktree add archive data-archive' for all historical files
# - Auto-sync: LaunchAgent runs daily at 3 AM to sync archive branch locally
#
# This eliminates the 30-day artifact expiration risk while keeping main branch clean
public/data/etoro-data-*.json
public/reports/etoro-census-*.html

# Archive worktree directory (created by sync script)
archive/

# Keep the latest file tracked for Vercel (negation pattern)
!public/data/census-data-latest.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Spotlight indexing opt-out marker (per-directory)
.metadata_never_index

# Secrets. A bare `.env` line does not cover `.env.bak-*`, `.env.local` or
# `.env.production`; a rotation script.s timestamped backup was staged into a
# public repo through exactly that gap. Keep the rule in the repo rather than
# in a global ignore file, which is machine-local and protects neither a fresh
# clone nor CI nor the VPS copy.
.env.*
