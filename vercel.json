{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "data-archive": false
    }
  },
  "github": {
    "silent": true,
    "autoJobCancelation": true,
    "autoAlias": false
  },
  "ignoreCommand": "bash ./ignore-build-step.sh",
  "installCommand": "npm ci --prefer-offline --no-audit",
  "rewrites": [
    {
      "source": "/",
      "destination": "/public"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
