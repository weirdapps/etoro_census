# Vercel Deployment Ignore File
# Exclude old reports and data files from deployment
# Keep ONLY the latest data file (~80MB) for /public functionality

# ==========================================
# EXCLUDE ALL HISTORICAL REPORTS
# ==========================================
public/reports/**/*.html

# ==========================================
# EXCLUDE OLD DATA FILES (Keep latest only)
# ==========================================
# CRITICAL: Vercel has 250MB serverless function limit
# Each data file is ~80MB, so we can only keep 1-2 files
# Exclude ALL data files EXCEPT the latest one

# Exclude all JSON data files except the fixed latest file
public/data/etoro-data-*.json

# Note: census-data-latest.json is NOT excluded and will be deployed
# This file should be updated by copying the latest etoro-data-*.json file
# Keep only this file to stay under 250MB limit

# ==========================================
# STANDARD EXCLUSIONS
# ==========================================
.github/
analysis/
node_modules/
.git/
.env*
*.md
!README.md

# Development files
.vscode/
.idea/
*.log
*.tsbuildinfo

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
