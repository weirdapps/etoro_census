# Vercel Deployment Ignore File
# Exclude old reports and data files from deployment
# Keep ONLY the latest data file (~80MB) for /public functionality

# ==========================================
# EXCLUDE ALL HISTORICAL REPORTS
# ==========================================
public/reports/**/*.html

# ==========================================
# EXCLUDE OLD DATA FILES (Keep latest only)
# ==========================================
# Keep ONLY the latest 3 data files for reliability
# Current pattern keeps files from October 23rd onwards

# Exclude all data files from earlier months (January-September)
public/data/etoro-data-2025-0[1-9]-*.json

# Exclude older October files (keep from 10-23 onwards)
public/data/etoro-data-2025-10-0[1-9]-*.json
public/data/etoro-data-2025-10-1[0-9]-*.json
public/data/etoro-data-2025-10-2[0-2]-*.json

# DO NOT exclude the symlink (needed for app to find latest data)
!public/data/latest-census.json

# ==========================================
# STANDARD EXCLUSIONS
# ==========================================
.github/
analysis/
node_modules/
.git/
.env*
*.md
!README.md

# Development files
.vscode/
.idea/
*.log
*.tsbuildinfo

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
